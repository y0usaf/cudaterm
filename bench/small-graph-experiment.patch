+struct SmallFeedGraph {
+  cudaGraph_t graph = nullptr;
+  cudaGraphExec_t executable = nullptr;
+  cudaGraphNode_t kernel = nullptr;
+  unsigned char *input = nullptr;
+  ReplyBuffer *output = nullptr;
+  size_t previous_length = 0;
+  ~SmallFeedGraph() {
+    if (executable)
+      cudaGraphExecDestroy(executable);
+    if (graph)
+      cudaGraphDestroy(graph);
+    cudaFreeHost(input);
+    cudaFreeHost(output);
+  }
+  void run(DeviceState *state, unsigned char *device_input, ReplyBuffer *replies,
+           const unsigned char *bytes, size_t length) {
+    const int *skip = nullptr;
+    int *resume = nullptr;
+    void *args[] = {&state, &device_input, &length, &skip, &skip, &resume};
+    cudaKernelNodeParams params{};
+    params.func = reinterpret_cast<void *>(feed_kernel);
+    params.gridDim = dim3(1);
+    params.blockDim = dim3(32);
+    params.kernelParams = args;
+    if (!executable) {
+      ck(cudaMallocHost(&input, 256));
+      ck(cudaMallocHost(&output, sizeof(ReplyBuffer)));
+      std::memset(input, 0, 256);
+      ck(cudaGraphCreate(&graph, 0));
+      cudaGraphNode_t copy_in, copy_out;
+      ck(cudaGraphAddMemcpyNode1D(&copy_in, graph, nullptr, 0, device_input,
+                                  input, 256, cudaMemcpyHostToDevice));
+      ck(cudaGraphAddKernelNode(&kernel, graph, &copy_in, 1, &params));
+      ck(cudaGraphAddMemcpyNode1D(&copy_out, graph, &kernel, 1, output, replies,
+                                  sizeof(ReplyBuffer), cudaMemcpyDeviceToHost));
+      ck(cudaGraphInstantiate(&executable, graph, 0));
+    } else if (length != previous_length)
+      ck(cudaGraphExecKernelNodeSetParams(executable, kernel, &params));
+    previous_length = length;
+    std::memcpy(input, bytes, length);
+    ck(cudaGraphLaunch(executable, nullptr));
+    ck(cudaStreamSynchronize(nullptr));
+  }
+};
