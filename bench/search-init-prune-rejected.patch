+__global__ void find_search_pruned(const DeviceState *s, SearchWork *q) {
+  unsigned rank = blockIdx.x * blockDim.x + threadIdx.x;
+  if (rank >= (unsigned)q->total) return;
+  auto bound = cuda::atomic_ref<unsigned, cuda::thread_scope_device>(q->rank);
+  if (rank >= bound.load(cuda::memory_order_relaxed)) return;
+  int token = (q->start + q->step * int(rank) + q->total) % q->total;
+  int er, ec;
+  if (search_at(*s, *q, token, er, ec)) bound.fetch_min(rank, cuda::memory_order_relaxed);
+}
