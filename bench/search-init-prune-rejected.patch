+__global__ void initialize_search(const DeviceState *s, SearchWork *q) {
+  int history = s->alt_active ? 0 : s->history_count;
+  q->total = (history + s->rows) * s->cols * 4;
+  if (q->token >= 0)
+    q->start = (q->token + q->step + q->total) % q->total;
+  else if (q->step > 0)
+    q->start = (history - s->view_offset) * s->cols * 4;
+  else
+    q->start = (history - s->view_offset + s->rows) * s->cols * 4 - 1;
+  q->rank = 0xffffffffu;
+  q->match = {false, false, 0, 0, 0, 0, s->view_offset};
+}
