+static int snapToIncrement(_GLFWwindow* window, int size, int increment, int base)
+{
+    const int scale = window->wl.fractionalScale ?
+        (int) window->wl.scalingNumerator : window->wl.bufferScale * 120;
+    const int pixels = size * scale / 120;
+
+    if (increment <= 0 || pixels - base < increment)
+        return size;
+
+    const int snapped = base + (pixels - base) / increment * increment;
+    return (snapped * 120 + scale - 1) / scale;
+}
+
+static void snapToIncrements(_GLFWwindow* window, int* width, int* height)
+{
+    if (!window->wl.pending.sized || window->wl.maximized ||
+        window->wl.fullscreen || window->wl.tiled)
+    {
+        return;
+    }
+
+    *width = snapToIncrement(window, *width,
+                             window->wl.increment.width,
+                             window->wl.increment.baseWidth);
+    *height = snapToIncrement(window, *height,
+                              window->wl.increment.height,
+                              window->wl.increment.baseHeight);
+}
