+GLFWAPI void glfwSetWaylandSizeIncrements(GLFWwindow* handle,
+                                          int width,
+                                          int height,
+                                          int baseWidth,
+                                          int baseHeight)
+{
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    _GLFW_REQUIRE_INIT();
+
+    if (_glfw.platform.platformID != GLFW_PLATFORM_WAYLAND)
+    {
+        _glfwInputError(GLFW_PLATFORM_UNAVAILABLE,
+                        "Wayland: Platform not initialized");
+        return;
+    }
+
+    window->wl.increment.width = width;
+    window->wl.increment.height = height;
+    window->wl.increment.baseWidth = baseWidth;
+    window->wl.increment.baseHeight = baseHeight;
+
+    if (!window->wl.xdg.toplevel || !window->wl.pending.sized)
+        return;
+
+    width = window->wl.pending.width;
+    height = window->wl.pending.height;
+    snapToIncrements(window, &width, &height);
+
+    if (resizeWindow(window, width, height))
+    {
+        _glfwInputWindowSize(window, window->wl.width, window->wl.height);
+
+        if (window->wl.visible)
+            _glfwInputWindowDamage(window);
+    }
+}
