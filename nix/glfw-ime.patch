+static GLFWbool createTextInput(_GLFWwindow* window)
+{
+    if (window->wl.textInput)
+        return GLFW_TRUE;
+
+    if (!_glfw.wl.textInputManager || !_glfw.wl.seat)
+        return GLFW_FALSE;
+
+    window->wl.textInput =
+        zwp_text_input_manager_v3_get_text_input(_glfw.wl.textInputManager,
+                                                 _glfw.wl.seat);
+    if (!window->wl.textInput)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Failed to create text input object");
+        return GLFW_FALSE;
+    }
+
+    if (zwp_text_input_v3_add_listener(window->wl.textInput,
+                                       &textInputListener,
+                                       window) != 0)
+    {
+        zwp_text_input_v3_destroy(window->wl.textInput);
+        window->wl.textInput = NULL;
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Failed to listen for text input events");
+        return GLFW_FALSE;
+    }
+
+    return GLFW_TRUE;
+}
+
+static void commitTextInputEnable(_GLFWwindow* window)
+{
+    zwp_text_input_v3_enable(window->wl.textInput);
+    zwp_text_input_v3_set_content_type(
+        window->wl.textInput,
+        ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE,
+        ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TERMINAL);
+    zwp_text_input_v3_set_cursor_rectangle(
+        window->wl.textInput,
+        window->wl.textInputCursorX,
+        window->wl.textInputCursorY,
+        window->wl.textInputCursorWidth,
+        window->wl.textInputCursorHeight);
+    zwp_text_input_v3_commit(window->wl.textInput);
 }
 
