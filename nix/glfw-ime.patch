+GLFWbool _glfwWaylandTextInputSupported(void)
+{
+    return _glfw.wl.textInputManager && _glfw.wl.seat;
+}
+
+void _glfwSetWaylandTextInputCallback(
+    _GLFWwindow* window,
+    _GLFWwaylandTextInputCallback callback,
+    void* user)
+{
+    window->wl.textInputCallback = callback;
+    window->wl.textInputUser = user;
+    if (callback)
+        createTextInput(window);
+}
+
+void _glfwEnableWaylandTextInput(_GLFWwindow* window,
+                                 int32_t x,
+                                 int32_t y,
+                                 int32_t width,
+                                 int32_t height)
+{
+    if (!createTextInput(window))
+        return;
+
+    window->wl.textInputCursorX = x;
+    window->wl.textInputCursorY = y;
+    window->wl.textInputCursorWidth = width;
+    window->wl.textInputCursorHeight = height;
+    window->wl.textInputEnabled = GLFW_TRUE;
+
+    if (window->wl.textInputEntered)
+        commitTextInputEnable(window);
+}
+
+void _glfwDisableWaylandTextInput(_GLFWwindow* window)
+{
+    if (!window->wl.textInput)
+        return;
+
+    if (window->wl.textInputEnabled && window->wl.textInputEntered)
+    {
+        zwp_text_input_v3_disable(window->wl.textInput);
+        zwp_text_input_v3_commit(window->wl.textInput);
+    }
+    window->wl.textInputEnabled = GLFW_FALSE;
+}
+
+void _glfwSetWaylandTextInputCursorRectangle(_GLFWwindow* window,
+                                             int32_t x,
+                                             int32_t y,
+                                             int32_t width,
+                                             int32_t height)
+{
+    if (!window->wl.textInput)
+        return;
+
+    if (window->wl.textInputCursorX == x &&
+        window->wl.textInputCursorY == y &&
+        window->wl.textInputCursorWidth == width &&
+        window->wl.textInputCursorHeight == height)
+    {
+        return;
+    }
+
+    window->wl.textInputCursorX = x;
+    window->wl.textInputCursorY = y;
+    window->wl.textInputCursorWidth = width;
+    window->wl.textInputCursorHeight = height;
+
+    if (window->wl.textInputEnabled && window->wl.textInputEntered)
+    {
+        zwp_text_input_v3_set_cursor_rectangle(
+            window->wl.textInput, x, y, width, height);
+        zwp_text_input_v3_commit(window->wl.textInput);
+    }
+}
