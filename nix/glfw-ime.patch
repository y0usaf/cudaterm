+static void textInputEmit(_GLFWwindow* window,
+                          int event,
+                          const char* text,
+                          int32_t cursorBegin,
+                          int32_t cursorEnd,
+                          uint32_t deleteBefore,
+                          uint32_t deleteAfter)
+{
+    if (window->wl.textInputCallback)
+    {
+        window->wl.textInputCallback(window->wl.textInputUser,
+                                     event,
+                                     text,
+                                     cursorBegin,
+                                     cursorEnd,
+                                     deleteBefore,
+                                     deleteAfter);
+    }
+}
+
+static void commitTextInputEnable(_GLFWwindow* window);
+
+static void textInputHandleEnter(void* userData,
+                                 struct zwp_text_input_v3* textInput,
+                                 struct wl_surface* surface)
+{
+    _GLFWwindow* window = userData;
+    if (textInput != window->wl.textInput || surface != window->wl.surface)
+        return;
+
+    window->wl.textInputEntered = GLFW_TRUE;
+    if (window->wl.textInputEnabled)
+        commitTextInputEnable(window);
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_ENTER,
+                  NULL, 0, 0, 0, 0);
+}
+
+static void textInputHandleLeave(void* userData,
+                                 struct zwp_text_input_v3* textInput,
+                                 struct wl_surface* surface)
+{
+    _GLFWwindow* window = userData;
+    if (textInput != window->wl.textInput || surface != window->wl.surface)
+        return;
+
+    window->wl.textInputEntered = GLFW_FALSE;
+    window->wl.textInputEnabled = GLFW_FALSE;
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_LEAVE,
+                  NULL, 0, 0, 0, 0);
+}
+
+static void textInputHandlePreeditString(void* userData,
+                                         struct zwp_text_input_v3* textInput,
+                                         const char* text,
+                                         int32_t cursorBegin,
+                                         int32_t cursorEnd)
+{
+    _GLFWwindow* window = userData;
+    if (textInput != window->wl.textInput || !window->wl.textInputEntered)
+        return;
+
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_PREEDIT,
+                  text, cursorBegin, cursorEnd, 0, 0);
+}
+
+static void textInputHandleCommitString(void* userData,
+                                        struct zwp_text_input_v3* textInput,
+                                        const char* text)
+{
+    _GLFWwindow* window = userData;
+    if (textInput != window->wl.textInput || !window->wl.textInputEntered)
+        return;
+
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_COMMIT,
+                  text, 0, 0, 0, 0);
+}
+
+static void textInputHandleDeleteSurroundingText(
+    void* userData,
+    struct zwp_text_input_v3* textInput,
+    uint32_t beforeLength,
+    uint32_t afterLength)
+{
+    _GLFWwindow* window = userData;
+    if (textInput != window->wl.textInput || !window->wl.textInputEntered)
+        return;
+
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_DELETE_SURROUNDING,
+                  NULL, 0, 0, beforeLength, afterLength);
+}
+
+static void textInputHandleDone(void* userData,
+                                struct zwp_text_input_v3* textInput,
+                                uint32_t serial)
+{
+    _GLFWwindow* window = userData;
+    (void) serial;
+    if (textInput != window->wl.textInput || !window->wl.textInputEntered)
+        return;
+
+    textInputEmit(window, _GLFW_WAYLAND_TEXT_INPUT_DONE,
+                  NULL, 0, 0, 0, 0);
+}
+
+// Version 2 events are currently metadata that the bridge does not expose.
+// Keep non-NULL listeners so a version 2 compositor cannot dispatch through a
