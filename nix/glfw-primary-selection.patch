+// Write primary selection data without allowing a consumer that closes its
+// pipe early to terminate the terminal with SIGPIPE.  The mask is local to
+// this thread and the signal disposition is never changed, so child
+// processes inherit their normal SIGPIPE behavior.
+static void writePrimarySelectionString(int fd, const char* string, size_t length)
+{
+    sigset_t block;
+    sigset_t oldMask;
+    sigset_t pendingBefore;
+    struct timespec deadline;
+    int flags;
+    GLFWbool pendingKnown;
+
+    if (sigemptyset(&block) != 0 || sigaddset(&block, SIGPIPE) != 0 ||
+        pthread_sigmask(SIG_BLOCK, &block, &oldMask) != 0)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Failed to protect primary selection transfer");
+        return;
+    }
+
+    pendingKnown = sigpending(&pendingBefore) == 0;
+    const GLFWbool hadPendingSigpipe = pendingKnown &&
+        sigismember(&pendingBefore, SIGPIPE) == 1;
+
+    flags = fcntl(fd, F_GETFL, 0);
+    if (flags == -1 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) == -1 ||
+        clock_gettime(CLOCK_MONOTONIC, &deadline) == -1)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Failed to prepare primary selection transfer");
+        pthread_sigmask(SIG_SETMASK, &oldMask, NULL);
+        return;
+    }
+    deadline.tv_sec += 5;
+
+    while (length > 0)
+    {
+        struct timespec now;
+        long long remainingMilliseconds;
+        struct pollfd pollfd = { fd, POLLOUT | POLLERR | POLLHUP, 0 };
+        int ready;
+
+        if (clock_gettime(CLOCK_MONOTONIC, &now) == -1)
+            break;
+        remainingMilliseconds =
+            ((long long) deadline.tv_sec - now.tv_sec) * 1000 +
+            (deadline.tv_nsec - now.tv_nsec + 999999) / 1000000;
+        if (remainingMilliseconds <= 0)
+            break;
+        if (remainingMilliseconds > 5000)
+            remainingMilliseconds = 5000;
+
+        do
+        {
+            ready = poll(&pollfd, 1, (int) remainingMilliseconds);
+        }
+        while (ready == -1 && errno == EINTR);
+
+        if (ready <= 0 || (pollfd.revents & (POLLERR | POLLHUP | POLLNVAL)))
+            break;
+
+        const ssize_t result = write(fd, string, length);
+        if (result == -1)
+        {
+            if (errno == EINTR)
+                continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                continue;
+            break;
+        }
+        if (result == 0)
+            break;
+
+        length -= result;
+        string += result;
+    }
+
+    if (!hadPendingSigpipe)
+    {
+        sigset_t pendingAfter;
+        if (sigpending(&pendingAfter) == 0 &&
+            sigismember(&pendingAfter, SIGPIPE) == 1)
+        {
+            struct timespec timeout = { 0, 0 };
+            while (sigtimedwait(&block, NULL, &timeout) == -1 &&
+                   errno == EINTR)
+            {
+            }
+        }
+    }
+
+    pthread_sigmask(SIG_SETMASK, &oldMask, NULL);
+}
+
+static void primarySelectionSourceHandleSend(
+    void* userData,
+    struct zwp_primary_selection_source_v1* source,
+    const char* mimeType,
+    int fd)
+{
+    if (_glfw.wl.primarySelectionSource != source ||
+        (strcmp(mimeType, "text/plain;charset=utf-8") != 0 &&
+         strcmp(mimeType, "text/plain") != 0))
+    {
+        close(fd);
+        return;
+    }
+
+    const size_t maxLength = 64u << 20;
+    const char* string = _glfw.wl.primarySelectionString;
+    const size_t length = strnlen(string, maxLength + 1);
+    if (length > maxLength)
+    {
+        _glfwInputError(GLFW_FORMAT_UNAVAILABLE,
+                        "Wayland: Primary selection exceeds 64 MiB");
+        close(fd);
+        return;
+    }
+
+    writePrimarySelectionString(fd, string, length);
+    close(fd);
+}
+
+static void primarySelectionSourceHandleCancelled(
+    void* userData,
+    struct zwp_primary_selection_source_v1* source)
+{
+    zwp_primary_selection_source_v1_destroy(source);
+
+    if (_glfw.wl.primarySelectionSource == source)
+        _glfw.wl.primarySelectionSource = NULL;
+}
