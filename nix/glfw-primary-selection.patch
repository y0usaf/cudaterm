+ *  @thread_safety This function must only be called from the main thread.
+ *
+ *  @since Added by Cudaterm's GLFW Wayland primary-selection extension.
+ *
+ *  @ingroup native
+ */
+GLFWAPI int glfwWaylandPrimarySelectionSupported(void);
+
+/*! @brief Sets the current Wayland primary selection to the specified string.
+ *
+ *  @param[in] string A UTF-8 encoded string.
+ *
+ *  @errors Possible errors include @ref GLFW_NOT_INITIALIZED, @ref
+ *  GLFW_PLATFORM_UNAVAILABLE and @ref GLFW_PLATFORM_ERROR.
+ *
+ *  @pointer_lifetime The specified string is copied before this function
+ *  returns.
+ *
+ *  @thread_safety This function must only be called from the main thread.
+ *
+ *  @since Added by Cudaterm's GLFW Wayland primary-selection extension.
+ *
+ *  @ingroup native
+ */
+GLFWAPI void glfwSetWaylandPrimarySelectionString(const char* string);
+
+/*! @brief Returns the current Wayland primary selection as a string.
+ *
+ *  @return The primary selection as UTF-8, or `NULL` if unavailable.
+ *
+ *  @errors Possible errors include @ref GLFW_NOT_INITIALIZED, @ref
+ *  GLFW_PLATFORM_UNAVAILABLE, @ref GLFW_PLATFORM_ERROR and @ref
+ *  GLFW_FORMAT_UNAVAILABLE.
+ *
+ *  @pointer_lifetime The returned string is allocated and freed by GLFW. It
+ *  remains valid until the next get or set call, or until termination.
+ *
+ *  @thread_safety This function must only be called from the main thread.
+ *
+ *  @since Added by Cudaterm's GLFW Wayland primary-selection extension.
+ *
+ *  @ingroup native
+ */
+GLFWAPI const char* glfwGetWaylandPrimarySelectionString(void);
+
