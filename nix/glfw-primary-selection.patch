+// Reads the specified primary selection offer as the specified MIME type
+//
+static char* readPrimarySelectionOfferAsString(
+    struct zwp_primary_selection_offer_v1* offer, const char* mimeType)
+{
+    int fds[2];
+
+    if (pipe2(fds, O_CLOEXEC) == -1)
+    {
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Failed to create pipe for primary selection: %s",
+                        strerror(errno));
+        return NULL;
+    }
+
+    zwp_primary_selection_offer_v1_receive(offer, mimeType, fds[1]);
+    flushDisplay();
+    close(fds[1]);
+
+    char* string = NULL;
+    size_t size = 0;
+    size_t length = 0;
+    const size_t maxLength = 64u << 20;
+
+    for (;;)
+    {
+        struct pollfd pollfd = { fds[0], POLLIN | POLLHUP | POLLERR, 0 };
+        int ready;
+        do
+        {
+            ready = poll(&pollfd, 1, 5000);
+        }
+        while (ready == -1 && errno == EINTR);
+
+        if (ready == 0)
+        {
+            _glfwInputError(GLFW_PLATFORM_ERROR,
+                            "Wayland: Timed out reading primary selection");
+            _glfw_free(string);
+            close(fds[0]);
+            return NULL;
+        }
+        if (ready == -1)
+        {
+            _glfwInputError(GLFW_PLATFORM_ERROR,
+                            "Wayland: Failed to poll primary selection: %s",
+                            strerror(errno));
+            _glfw_free(string);
+            close(fds[0]);
+            return NULL;
+        }
+
+        // Read one extra byte when the cap is reached so an exactly-cap-sized
+        // transfer is accepted while a larger transfer is rejected.
+        const size_t remaining = maxLength + 1 - length;
+        const size_t readSize = remaining < 4096 ? remaining : 4096;
+        const size_t requiredSize = length + readSize + 1;
+        if (requiredSize > size)
+        {
+            char* longer = _glfw_realloc(string, requiredSize);
+            if (!longer)
+            {
+                _glfwInputError(GLFW_OUT_OF_MEMORY, NULL);
+                _glfw_free(string);
+                close(fds[0]);
+                return NULL;
+            }
+
+            string = longer;
+            size = requiredSize;
+        }
+
+        const ssize_t result = read(fds[0], string + length, readSize);
+        if (result == 0)
+            break;
+        else if (result == -1)
+        {
+            if (errno == EINTR)
+                continue;
+
+            _glfwInputError(GLFW_PLATFORM_ERROR,
+                            "Wayland: Failed to read primary selection: %s",
+                            strerror(errno));
+            _glfw_free(string);
+            close(fds[0]);
+            return NULL;
+        }
+
+        length += result;
+        if (length > maxLength)
+        {
+            _glfwInputError(GLFW_FORMAT_UNAVAILABLE,
+                            "Wayland: Primary selection exceeds 64 MiB");
+            _glfw_free(string);
+            close(fds[0]);
+            return NULL;
+        }
